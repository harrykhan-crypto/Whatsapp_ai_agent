# Copy this file to .env and fill in your values. Never commit .env.

# ---------------- LMS ----------------
MOODLE_URL=https://fall2026.auplmscs.com
# Existing logged-in browser profile (kept as is, never deleted)
BROWSER_PROFILE_DIR=moodle_browser_profile
# false = visible window (needed when you sign in); true = run hidden once signed in
BROWSER_HEADLESS=false
# Optional: use installed Chrome/Edge instead of Playwright's Chromium ("chrome" or "msedge")
BROWSER_CHANNEL=
BROWSER_EXECUTABLE_PATH=
STUDENT_NAME=Harry

# ---------------- WhatsApp ----------------
# agent   = WhatsApp Agent Platform (your existing whagent integration, no public URL needed)  [default]
# cloud   = official WhatsApp Cloud API (needs a public HTTPS webhook URL)
# console = print messages in the terminal (testing)
WHATSAPP_PROVIDER=agent

# For WHATSAPP_PROVIDER=agent
WHATSAPP_AGENT_API_KEY=

# For WHATSAPP_PROVIDER=cloud
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=choose-a-long-random-string
WHATSAPP_APP_SECRET=
# Your own number with country code, no + (e.g. 923001234567)
WHATSAPP_RECIPIENT=
# Only these numbers may send commands (defaults to WHATSAPP_RECIPIENT)
WHATSAPP_ALLOWED_NUMBERS=
WHATSAPP_API_VERSION=v21.0
# Approved message template used to reopen the chat after 24h of silence (Cloud API rule)
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en_US

# ---------------- Schedule (Asia/Karachi) ----------------
TIMEZONE=Asia/Karachi
SYNC_INTERVAL_MINUTES=30
MORNING_SUMMARY_TIME=08:00
EVENING_REMINDER_TIME=20:00
REMINDER_HOURS=24,3
ENABLE_SCHEDULER=true

# ---------------- Local server ----------------
HOST=127.0.0.1
PORT=5000
# Required if the server is reachable through a tunnel (ngrok/cloudflared): send as X-API-Key
LOCAL_API_KEY=

# ---------------- Storage ----------------
DATABASE_PATH=storage/agent.db
DOWNLOAD_DIR=storage/downloads
BACKUP_DIR=storage/backups
LOG_DIR=logs
MAX_DOWNLOAD_MB=16
BACKUPS_TO_KEEP=7

# ---------------- Free local AI (optional) ----------------
# Understands any wording when the built-in rules don't. Install Ollama (https://ollama.com),
# then run:  ollama pull qwen2.5:3b     (about 2 GB, runs offline on your PC)
AI_MODE=auto
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
AI_TIMEOUT=60
